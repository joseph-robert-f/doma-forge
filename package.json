{
  "name": "drawerforge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vitest run tests/*.integration.test.tsx",
    "test:ssr": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:browser": "playwright test",
    "test:deploy-config": "CLOUDFLARE_ENV=preview npm run build && node --test tests/wrangler-preview-env.test.mjs",
    "check:public-origin": "node scripts/check-public-origin.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "deploy": "vinext deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview vinext deploy --preview"
  },
  "dependencies": {
    "manifold-3d": "^3.5.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "26.1.0",
    "playwright-core": "1.56.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
